# IntelliShell Environment Configuration
# Default values for all environments. Override with config/local.env (git-ignored).

# Service ports (bind to 127.0.0.1 only)
CORE_ENGINE_PORT=3000
AI_SERVICE_PORT=8000
DASHBOARD_PORT=5173
OLLAMA_PORT=11434

# LLM configuration
OLLAMA_MODEL=phi3:mini

# System requirements (GB)
MIN_DISK_GB=5
WARN_DISK_GB=20
MIN_RAM_GB=4

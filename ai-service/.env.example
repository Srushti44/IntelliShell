# IntelliShell AI Service Configuration

# ==== Ollama Configuration (Primary Provider) ====
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini

# ==== Groq Configuration (Fallback Provider) ====
# Leave empty to disable cloud fallback
# Get API key from: https://console.groq.com/keys
GROQ_API_KEY=

# Groq model to use (default: llama-3.3-70b-versatile)
# Other options: llama3-70b-8192, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# Enable/disable Groq fallback (default: true if API key is set)
ENABLE_GROQ_FALLBACK=true

# ==== Core Engine Integration ====
CORE_ENGINE_URL=http://localhost:3000

# ==== Timeouts ====
# Provider request timeout in seconds
PROVIDER_TIMEOUT=120

# Token TTL in seconds (how long confirmation tokens remain valid)
TOKEN_TTL_SECONDS=300
